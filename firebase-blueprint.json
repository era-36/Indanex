  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profiles isolated by UID."
    },
    "/companies/{companyId}": {
      "schema": { "$ref": "#/entities/Company" },
      "description": "Registered industrial company records."
    },
    "/companies/{companyId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/CompanyMember" },
      "description": "Company-scoped RBAC membership documents."
    },
    "/companies/{companyId}/departments/{departmentId}": {
      "schema": { "$ref": "#/entities/Department" },
      "description": "Departments within an industrial company."
    },
    "/companies/{companyId}/industrial_profiles/{profileId}": {
      "schema": { "$ref": "#/entities/IndustrialProfile" },
      "description": "Segment-specific operational problem validations and QC/compliance presets."
    },
    "/companies/{companyId}/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Registered company suppliers."
    },
    "/companies/{companyId}/inventory/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Raw material and finished goods inventory records."
    },
    "/companies/{companyId}/stock_movements/{movementId}": {
      "schema": { "$ref": "#/entities/StockMovement" },
      "description": "Stock movement ledger entries."
    },
    "/companies/{companyId}/purchase_orders/{poId}": {
      "schema": { "$ref": "#/entities/PurchaseOrder" },
      "description": "Supplier purchase orders and delivery tracking."
    },
    "/companies/{companyId}/production_orders/{orderId}": {
      "schema": { "$ref": "#/entities/ProductionOrder" },
      "description": "Production orders, batch targets, and schedules."
    },
    "/companies/{companyId}/machines/{machineId}": {
      "schema": { "$ref": "#/entities/Machine" },
      "description": "Plant machines and utilization tracking."
    },
    "/companies/{companyId}/machine_downtime/{downtimeId}": {
      "schema": { "$ref": "#/entities/MachineDowntime" },
      "description": "Machine downtime incidents."
    },
    "/companies/{companyId}/quality_inspections/{inspectionId}": {
      "schema": { "$ref": "#/entities/QualityInspection" },
      "description": "Quality control inspections and human release decisions."
    },
    "/companies/{companyId}/safety_incidents/{incidentId}": {
      "schema": { "$ref": "#/entities/SafetyIncident" },
      "description": "Safety incident reports."
    },
    "/companies/{companyId}/compliance_documents/{docId}": {
      "schema": { "$ref": "#/entities/ComplianceDocument" },
      "description": "Regulatory compliance checklists and expiry documents."
    },
    "/companies/{companyId}/ai_recommendations/{recId}": {
      "schema": { "$ref": "#/entities/AiRecommendation" },
      "description": "Logged AI operational insights."
    },
    "/companies/{companyId}/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable append-only audit logs."
    },
    "/demo_enquiries/{enquiryId}": {
      "schema": { "$ref": "#/entities/DemoEnquiry" },
      "description": "Public demo and onboarding enquiries."
    },
    "/platform_settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSetting" },
      "description": "Super Admin platform configuration records."
    }
  }
}
