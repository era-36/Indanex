    "UserProfile": {
      "title": "User Profile",
      "description": "Private user account profile and tenant membership pointer.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["super_admin", "company_admin", "department_manager", "operator"] },
        "companyId": { "type": "string", "maxLength": 128 },
        "departmentId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "pending", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "status", "createdAt", "updatedAt"]
    },
